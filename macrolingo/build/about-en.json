,{"id":"a57003","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"_title":"Adam words","css_classes":"ml-reveal ml-reveal-1"},"elements":[{"id":"a43aad","elType":"widget","widgetType":"heading","settings":{"title":"&ldquo;Challenge us!&rdquo;","header_size":"h6","_css_classes":"ml-label","_title":"Label"},"elements":[]},{"id":"a4599c","elType":"widget","widgetType":"heading","settings":{"title":"Dr. Adam Goulston","header_size":"h2","_css_classes":"ml-heading-founder","_title":"Heading","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"a4788b","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>I started this company because I saw how normal agencies couldn&rsquo;t handle difficult topics and global readers. We&rsquo;re uniquely for that. I was born and raised in the US and have lived in Asia most of my adult life. Learning foreign languages and applying journalism and a research mindset come naturally, and I work with others who have those abilities and global experience.</p>","_css_classes":"ml-bio-wide","_title":"What Adam says","__globals__":{"text_color":"globals/colors?id=text"}},"elements":[]},{"id":"a51336","elType":"widget","widgetType":"icon-list","settings":{"icon_list":[{"_id":"a4977a","text":"PsyD (doctorate in psychology), Human and Organizational Psychology","selected_icon":{"value":"fas fa-check","library":"fa-solid"},"link":{"url":"","is_external":"","nofollow":"","custom_attributes":"","label":""}},{"_id":"a4b669","text":"MBA, Marketing &middot; MS, Health Sciences (public health)","selected_icon":{"value":"fas fa-check","library":"fa-solid"},"link":{"url":"","is_external":"","nofollow":"","custom_attributes":"","label":""}},{"_id":"a4d558","text":"MISD (MA equivalent), International Social Development &middot; BA, Journalism","selected_icon":{"value":"fas fa-check","library":"fa-solid