inner  ml-band-mint","_title":"Made in Japan"},"elements":[{"id":"a5ebbf","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-section-head ml-reveal","_title":"Section heading"},"elements":[{"id":"a5ade1","elType":"widget","widgetType":"heading","settings":{"title":"Made in Japan and in the West","header_size":"h6","align":"center","_css_classes":"ml-label ml-label-centred","_title":"Label"},"elements":[]},{"id":"a5ccd0","elType":"widget","widgetType":"heading","settings":{"title":"Applying <i>yarigai</i> and <i>kaizen</i> to <span class=\"ml-highlight\">global content</span>","header_size":"h2","align":"center","_title":"Heading","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]}]},{"id":"a60aae","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>MacroLingo (formerly Scize Group) was founded in Fukuoka, Japan, and relocated to Osaka, Japan. The Japanese-ness is strong in us, despite the Western background. The customer is a god. Listen carefully and look at the whole situation. Relentlessly pursue quality. Value everything we do (<i>yarigai</i>). Seek and apply continual improvement (<i>kaizen</i>). These work ethics underpin all our work, no matter where the client is from. Yet, we don&rsquo;t neglect our heart, competitive spirit, and speed to implementation characteristic of the American work ethic (with a sprinkle of Aussie amiability and adaptability). We&rsquo;ll bring you the best of both worlds, for the whole world.</p>","_css_classes":"ml-prose ml-reveal ml-reveal-1","_title":"The passage"},"elements":[]}]},{"id":"a6866a","elType":"container","settings":{"padding":{"unit":"px","top":"38","right":"30","bottom":"44","left":"30","isLinked":fal