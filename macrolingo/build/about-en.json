I was born and raised in the US and have lived in Asia most of my adult life. Learning foreign languages and applying journalism and a research mindset come naturally, and I work with others who have those abilities and global experience.</p>","_css_classes":"ml-bio-wide","_title":"What Adam says","__globals__":{"text_color":"globals/colors?id=text"}},"elements":[]},{"id":"a4f447","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>-Dr. Adam Goulston, MacroLingo Owner</p>","_css_classes":"ml-signature","_title":"Signature"},"elements":[]},{"id":"a5ebbf","elType":"widget","widgetType":"icon-list","settings":{"icon_list":[{"_id":"a51336","text":"PsyD (doctorate in psychology), Human and Organizational Psychology","selected_icon":{"value":"fas fa-check","library":"fa-solid"},"link":{"url":"","is_external":"","nofollow":"","custom_attributes":"","label":""}},{"_id":"a53225","text":"MBA, Marketing","selected_icon":{"value":"fas fa-check","library":"fa-solid"},"link":{"url":"","is_external":"","nofollow":"","custom_attributes":"","label":""}},{"_id":"a55114","text":"MS, Health Sciences (public health)","selected_icon":{"value":"fas fa-check","library":"fa-solid"},"link":{"url":"","is_external":"","nofollow":"","custom_attributes":"","label":""}},{"_id":"a57003","text":"MISD (MA equivalent), International Social Development","selected_icon":{"value":"fas fa-check","library":"fa-solid"},"link":{"url":"","is_external":"","nofollow":"","custom_attributes":"","label":""}},{"_id":"a58ef2","text":"BA, Journalism","selected_icon":{"value":"fas fa-check","library":"fa-solid"},"link":{"url":"","is_external":"","nofollow":"","custom_attributes":"","label":""}},{"_id":"a5ade1","text":"Board-certified Editor in the Life Sciences (ELS)","selected_icon":{"value":"fas fa-check","library":"fa-solid"},"link":{"url":"/what_is_a_bels_els_certified_editor/","is_external":"","nofollow":"","custom_attributes":"","label":""}},{"_id":"a5ccd0","text":"Certified Professional Resum