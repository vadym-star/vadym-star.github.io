re"},"elements":[{"id":"a17334","elType":"widget","widgetType":"image","settings":{"image":{"id":14544,"url":"https://staging1.macrolingo.com/wp-content/uploads/2024/08/japanese_business.jpg","alt":"MacroLingo Agency Assist、日本の広告代理店向けの英語サポート","source":"library","size":""},"image_size":"full","_css_classes":"ml-photo ml-photo-square","_title":"Hero photo"},"elements":[]}]}]},{"id":"a2899b","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","_element_id":"about","css_classes":"ml-inner ml-jp","_title":"What Agency Assist is"},"elements":[{"id":"a20ddf","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-section-head ml-reveal","_title":"Section heading"},"elements":[{"id":"a1d001","elType":"widget","widgetType":"heading","settings":{"title":"Agency Assistとは","header_size":"h6","align":"center","_css_classes":"ml-label ml-label-centred","_title":"Label"},"elements":[]},{"id":"a1eef0","elType":"widget","widgetType":"heading","settings":{"title":"世界で勝負するクライアントは<br>単なる「翻訳」<span class=\"ml-highlight\">以上</span>を求めている","header_size":"h2","align":"center","_title":"Heading","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]}]},{"id":"a22cce","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>クライアントにネイティブの高品質な英語を保証します。直訳や不自然な翻訳は全くありません。</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-1","_title":"The promise"},"elements":[]},{"id":"a24bbd","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>他の代理店にはない「切り札」になります。世界で勝負できるネイティブ英語翻訳、ローカライゼーション、コピーライティングが揃ったのが MacroLingo の Agency Assist です。</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-2","_title":"The difference"},"elements":[]},{"id":"a26aac","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Agency Assistを使用すれば、「この仕事を誰に依頼すべきか？」や「この翻訳者はやってほしいことを理解してくれるか？」などを心配する必要はありません。好みやニーズを熟知したパートナーとしてサポートします。</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-3","_title":"What it removes"},"elements":[]}]},{"id":"a41bbe","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","_element_id":"limits","css_classes":"ml-inner ml-jp ml-band-warm","_title":"Why translation is not enough"},"elements":[{"id":"a2e668","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-section-head ml-reveal","_title":"Section heading"},"elements":[{"id":"a2a88a","elType":"widget","widgetType":"heading","settings":{"title":"従来の翻訳プロセス","header_size":"h6","align":"center","_css_classes":"ml-label ml-label-centred","_title":"Label"},"elements":[]},{"id":"a2c779","elType":"widget","widgetType":"heading","settings":{"title":"何百年も変わらないやり方では、<span class=\"ml-highlight\">クリエイティブな仕事には届かない</span>","header_size":"h2","align":"center","_title":"Heading","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]}]},{"id":"a3fccf","elType":"container","settings":{"width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-split-founder ml-why-split ml-reveal ml-reveal-1","_title":"Picture and words"},"elements":[{"id":"a32446","elType":"container","settings":{"css_classes":"ml-why-photo","_title":"Picture"},"elements":[{"id":"a30557","elType":"widget","widgetType":"image","settings":{"image":{"id":14546,"url":"https://staging1.macrolingo.com/wp-content/uploads/2024/08/japanese-business-problem.jpg","alt":"日本企業が英語で直面する課題","source":"library","size":""},"image_size":"full","_css_classes":"ml-photo ml-photo-square","_title":"Picture"},"elements":[]}]},{"id":"a3dde0","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"_title":"Words"},"elements":[{"id":"a34335","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>翻訳のやり方は何百年もずっと同じです。典型的な翻訳プロセスは：</p>","_css_classes":"ml-bio-wide","_title":"Intro","__globals__":{"text_color":"globals/colors?id=text"}},"elements":[]},{"id":"a3a002","elType":"widget","widgetType":"icon-list","settings":{"icon_list":[{"_id":"a36224","text":"原文を「翻訳会社」に送る。","selected_icon":{"value":"fas fa-circle","library":"fa-solid"},"link":{"url":"","is_external":"","nofollow":"","custom_attributes":"","label":""}},{"_id":"a38113","text":"翻訳会社が同じスタイルとフォーマットを保持しつつ、単語ごとに翻訳します。","selected_icon":{"value":"fas fa-circle","library":"fa-solid"},"link":{"url":"","is_external":"","nofollow":"","custom_attributes":"","label":""}}],"view":"traditional","_css_classes":"ml-svc-list ml-i-dot","_title":"The two steps"},"elements":[]},{"id":"a3bef1","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>この方法は法的な翻訳、または単に事実を証明するための文書などであれば問題ありません。翻訳者は文字通りに翻訳を行うだけです。しかし、グローバルマーケティングなど、クリエイティブな仕事には不十分です。日本の多くの企業は、こうした文字通りの直訳はどれだけ効果が薄いかに気付いています。実際のところ、自然で引き込まれる英語が必要です。日本語のコンテンツであっても、企業が自然で引き込まれる日本語を求めているのと同じです。クライアントはそういったクオリティを求めています。Agency Assistは、このクオリティを提供します。</p>","_css_classes":"ml-bio-wide","_title":"Why it falls short","__globals__":{"text_color":"globals/colors?id=text"}},"elements":[]}]}]}]},{"id":"abf66d","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","_element_id":"issues","css_classes":"ml-inner ml-jp","_title":"Issues and answers"},"elements":[{"id":"abb88f","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-section-head ml-reveal","_title":"Section heading"},"elements":[{"id":"ab7ab1","elType":"widget","widgetType":"heading","settings":{"title":"代理店の課題と解決策","header_size":"h6","align":"center","_css_classes":"ml-label ml-label-centred","_title":"Label"},"elements":[]},{"id":"ab99a0","elType":"widget","widgetType":"heading","settings":{"title":"あなたのagencyには<br>こんな問題を抱えて<span class=\"ml-highlight\">いませんか？</span>","header_size":"h2","align":"center","_title":"Heading","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]}]},{"id":"abd77e","elType":"container","settings":{"flex_direction":"row","flex_gap":{"unit":"px","size":"22","column":"22","row":"22","isLinked":true},"flex_wrap":"wrap","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"46","right":"0","bottom":"0","left":"0","isLinked":false},"flex_align_items":"stretch","css_classes":"ml-two-up ml-asks-grid","_title":"The twelve issues"},"elements":[{"id":"a4b669","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-ask ml-issue ml-reveal","_title":"お客さまから高品質でクリエイティブな英語を要求される"}