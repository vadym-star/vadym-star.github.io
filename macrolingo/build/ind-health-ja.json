d":true},"flex_align_items":"stretch","_element_id":"case-study","css_classes":"ml-inner ml-jp","_title":"Case study"},"elements":[{"id":"bd9abb","elType":"container","settings":{"width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-cs ml-cs-solo ml-reveal","_title":"Case study"},"elements":[{"id":"bd7bcc","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"width":{"unit":"%","size":100},"css_classes":"ml-cs-words","_title":"The words"},"elements":[{"id":"bd1eff","elType":"widget","widgetType":"heading","settings":{"title":"事例","header_size":"h6","_css_classes":"ml-label","_title":"Label"},"elements":[]},{"id":"bd3dee","elType":"widget","widgetType":"heading","settings":{"title":"旭化成ファーマ株式会社","header_size":"h3","_css_classes":"ml-cs-head","_title":"Client","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"bd5cdd","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>日本の大手子会社であるこの企業は、新しいヘルスケア製品ラインのためのキャッチフレーズとコピーを必要としていました。MacroLingoが選ばれた理由は、日本語原文での対応が可能であったことに加え、翻訳以外にも製品分野や市場競争力、またラインナップを深くリサーチできることでした。ヘルスケア分野における専門知識を活かし、製品の詳細を的確に表しつつクライアントの意欲や求めるトーンを表現しました。英語に加えて、中国語の翻訳も弊社が担当しています。</p>","_css_classes":"ml-cs-val","_title":"What we did"},"elements":[]}]}]}]},{"id":"c25124","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","_element_id":"services","css_classes":"ml-inner ml-jp ml-band-blue","_title":"Services"},"elements":[{"id":"c1b679","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-section-head ml-reveal","_title":"Section heading"},"elements":[{"id":"c1789b","elType":"widget","widgetType":"heading","settings":{"title":"サービス内容","header_size":"h6","align":"center","_css_classes":"ml-label ml-label-centred","_title":"Label"},"elements":[]},{"id":"c1978a","elType":"widget","widgetType":"heading","settings":{"title":"ヘルスケア業界のリーダーとして信頼性を向上させるコンテンツ・SEO","header_size":"h2","align":"center","_title":"Heading","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]}]},{"id":"c1d568","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>日本のヘルスケア企業、団体、研究者向けに、以下のサービスを提供しています。</p>","_css_classes":"ml-lead ml-reveal ml-reveal-1","_title":"Intro"},"elements":[]},{"id":"c1f457","elType":"container","settings":{"flex_direction":"row","flex_gap":{"unit":"px","size":"22","column":"22","row":"22","isLinked":true},"flex_wrap":"wrap","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"flex_align_items":"stretch","css_classes":"ml-svc-grid ml-reveal ml-reveal-2","_title":"The services"},"elements":[{"id":"be7344","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"ヘルスケア業界・SEOのための英文コンテンツ、ブログ"},"elements":[{"id":"bdd899","elType":"widget","widgetType":"heading","settings":{"title":"ヘルスケア業界・SEOのための英文コンテンツ、ブログ","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"bdf788","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>人間だからこそできる、詳細かつ情報豊かなブログで、ヘルスケアサービスのオンラインプレゼンスを高め、流通業者やバイヤーにアピールし、患者のエンゲージメントを向上させましょう。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"be1677","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>例えば、革新的なメンタルヘルス治療、リモート医療、患者教育などに焦点を当てたブログシリーズなどが例として考えられます。最新の治療法、患者のサクセスストーリー、専門家の洞察などのトピックを詳しく解説することで、読者に医療施設の専門性を包括的に伝えることができます。また、ヘルスケア分野における最新のトピックやトレンド、治療法について定期的にブログを更新することで、信頼できる情報発信者としての地位を確立することができます。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"be3566","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>宮崎県のクライアントのためにMacroLingoが執筆した記事を こちら からご覧いただけます。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"be5455","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>質の高いコンテンツを継続的に発信することは、読者層の教育だけでなく検索エンジンにおける上位表示（SEO）にも繋がります。また、より幅広い顧客層へのアピール、リード獲得や売り上げの向上、ビジネスチャンスにも効果があります。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"bf0def","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"ヘルスケア業界のためのSEO・ウェブプランニング"},"elements":[{"id":"be9233","elType":"widget","widgetType":"heading","settings":{"title":"ヘルスケア業界のためのSEO・ウェブプランニング","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"beb122","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>MacroLingoのSEOアプローチは、コンテンツを検索エンジンで上位表示させるための知識と真に価値のある信頼性の高いコンテンツへの熱意に裏付けられています。ページ上およびページ外のSEO対策に加えてこのようなアプローチを提供しています。分かりやすい英語でコンテンツを配信することで、オンラインプレゼンスを大幅に向上させることができます。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"bed011","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>検索順位や知名度を改善することで患者や顧客の問い合わせを増加させ、オンラインにおけるビジネス評価の向上につながります。まずは現状のコンテンツを総合的に分析し、改善・最適化が必要な分野を特定します。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"beef00","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>他にも、特定の用語や、リーダーとしての地位を確立できる分野を特定します。御社独自の医療サービス、治療法、医療イノベーションに焦点を当て、検索順位を向上させるためのオーダーメイドプランを作成します。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"bfa89a","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"ヘルスケア業界のための科学・学術英文校正"},"elements":[{"id":"bf2cde","elType":"widget","widgetType":"heading","settings":{"title":"ヘルスケア業界のための科学・学術英文校正","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"bf4bcd","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>MacroLingoの英文構成は、BELS認定校正者の監督の下行われます。明瞭性、正確性、また特定のガイドラインや最新の倫理・スタイル基準を遵守した上で、科学コンテンツの精査を行っています。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"bf6abc","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>専門性の高いエキスパートの英文校正サービスで、医学研究出版物の品質や読みやすさを向上させることができます。特に論文や研究などの複雑な分野では、文章の明瞭性と正確性が重要視されます。研究結果を医学界内外に効果的に伝えるためには、このような専門サービスを活用することが重要です。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"bf89ab","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>MacroLingoはこれまでに2,000本以上の原稿の英文校正を行なってきました。実績のあるサービスだからこそ、論文採用の可能性を高め、科学分野の議論に貢献し、研究機関の名声を向上させるお手伝いができるのです。リモート医療や学際的なアプローチなど、最先端のサービスを専門分野としています。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"c00567","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"グローバルヘルス研究・コミュニケーション支援"},"elements":[{"id":"bfc789","elType":"widget","widgetType":"heading","settings":{"title":"グローバルヘルス研究・コミュニケーション支援","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"bfe678","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>グローバルヘルス分野における研究イニシアチブをサポートします。日本は保健分野において世界の研究やプロジェクトをリードする国です。私たちは、このような日本の功績がもっと世界に知られるべきだと思っています。例えば、研究を行っていても、その成果を伝えるための時間やリソースが足りていない機関があるかも知れません。私たちが、医療専門家、政府関係者、一般市民を含むグローバルコミュニティに研究成果を効果的に広めるためのコミュニケーションサービスの構築をサポートします。 私たちはこのサービスを通じて、日本のヘルスリサーチの現状と世界における実用化のギャップを解消し、有益な洞察や発見を世界に届け、人々の健康を向上させることを目指しています。グローバルな課題とヘルスサイエンスの分野における学術・研究バックグラウンドを持っている私たちだからこそ、クライアントの皆様をサポートする資格があると考えています。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"c0a012","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"ヘルスケアソリューションのブランディング・コピーライティング"},"elements":[{"id":"c02456","elType":"widget","widgetType":"heading","settings":{"title":"ヘルスケアソリューションのブランディング・コピーライティング","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"c04345","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>タグライン、キャッチコピー、製品説明、サービス関連テキストなど、日本のヘルスケアプロバイダーや医療関連企業を対象に、インパクトのあるブランディング・コピーライティングを発案します。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"c06234","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>効果的かつ的確なブランディングを実現するため、MacroLingoでは実用的なマーケティングの知識を応用することに重点を置いています。ヘルスケア業界への理解に根ざしたアプローチを採用し、ターゲット層に響くだけでなく、プロバイダーのサービスや価値を正確に表現するマーケティング素材を提案します。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"c08123","elType":"widget","widget