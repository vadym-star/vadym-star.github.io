a6c448","elType":"container","settings":{"flex_direction":"row","flex_gap":{"unit":"px","size":"22","column":"22","row":"22","isLinked":true},"flex_wrap":"wrap","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"46","right":"0","bottom":"0","left":"0","isLinked":false},"flex_align_items":"stretch","css_classes":"ml-two-up","_title":"Two clients"},"elements":[{"id":"a58ef2","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-case ml-reveal","_title":"Germanwatch と CCPI"},"elements":[{"id":"a4f447","elType":"widget","widgetType":"image","settings":{"image":{"id":16703,"url":"https://staging1.macrolingo.com/wp-content/uploads/2025/02/GW-1-1.png","alt":"Germanwatch と CCPI","source":"library","size":""},"image_size":"full","_css_classes":"ml-case-logo","_title":"Germanwatch と CCPI"},"elements":[]},{"id":"a51336","elType":"widget","widgetType":"heading","settings":{"title":"英文校正・AI検索対策","header_size":"h6","_css_classes":"ml-case-tag","_title":"Tag"},"elements":[]},{"id":"a53225","elType":"widget","widgetType":"heading","settings":{"title":"Germanwatch と CCPI","header_size":"h3","_css_classes":"ml-case-title","_title":"Client","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"a55114","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>MacroLingoは、気候変動パフォーマンス指数（CCPI）を発行する Germanwatch e.V. の英文校正を担当しています。気候と政策に関する複雑な内容を通して一貫させること、用語を厳密に管理すること、政策担当者とメディアに適したトーンを保つことが求められる仕事です。</p><p>あわせて、Germanwatch の気候専門家による研究論文、ブログ記事、<a href=\"https://www.germanwatch.org/en/cri\" target=\"_blank\" rel=\"noopener\">気候リスク指数（Climate Risk Index）</a>の校正も行っています。</p>","_css_classes":"ml-case-note","_title":"What we do for them"},"elements":[]},{"id":"a57003","elType":"widget","widgetType":"button","settings":{"text":"CCPI の最新ランキングを見る","link":{"url":"https://ccpi.org/","is_extern