":"widget","widgetType":"heading","settings":{"title":"英語以外の資料からでも制作できますか？","header_size":"h3","_css_classes":"ml-ask-q","_title":"Question","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"a7daaf","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>できます。<a href=\"/ja/translation_localization/\">翻訳とローカライズ</a>は MacroLingo の中心的なサービスです。日本語をはじめとするアジア言語の資料から、英語のコンテンツを作成いたします。</p>","_css_classes":"ml-ask-a","_title":"Answer"},"elements":[]}]},{"id":"a8566b","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-ask ml-reveal ml-reveal-2","_title":"研究報告書や年次報告書の執筆もお願いできますか？"},"elements":[{"id":"a8188d","elType":"widget","widgetType":"heading","settings":{"title":"研究報告書や年次報告書の執筆もお願いできますか？","header_size":"h3","_css_classes":"ml-ask-q","_title":"Question","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"a8377c","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>報告書そのものの執筆は承っておりません。ただし、既存の報告書や研究成果の校正は喜んでお引き受けします（<a href=\"/ja/editing-proofreading/\">英文校正サービス</a>）。承認済みの資料をもとにした、事例紹介、解説記事、ウェブページ、マーケティング用コンテンツなど、公開用の制作物は承っております（<a href=\"/ja/english-copywriting/\">ライティングサービス</a>）。</p>","_css_classes":"ml-ask-a","_title":"Answer"},"elements":[]}]},{"id":"a8b338","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-ask ml-reveal ml-reveal-3","_title":"制作や校正に AI を使っていますか？"},"elements":[{"id":"a8755a","elType":"widget","widgetType":"heading","settings":{"title":"制作や校正に AI を使っていますか？","header_size":"h3","_css_classes":"ml-ask-q","_title":"Question","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"eleme