"size":14.5,"sizes":[]},"typography_font_weight":"600","typography_line_height":{"unit":"em","size":1.72,"sizes":[]},"border_radius":{"unit":"px","top":"8","right":"8","bottom":"8","left":"8","isLinked":false},"text_padding":{"unit":"px","top":"11","right":"21","bottom":"11","left":"21","isLinked":false},"_css_classes":"ml-btn-primary","_title":"Main button","__globals__":{"background_color":"globals/colors?id=primary"}},"elements":[]}]}]}]},{"id":"c7e016","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","_element_id":"why","css_classes":"ml-inner ml-jp ml-band-warm","_title":"Why this industry"},"elements":[{"id":"c7267c","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-section-head ml-reveal","_title":"Section heading"},"elements":[{"id":"c6e89e","elType":"widget","widgetType":"heading","settings":{"title":"日本の研究機関・シンクタンクのためのコンテンツと多言語サービス","header_size":"h6","align":"center","_css_classes":"ml-label ml-label-centred","_title":"Label"},"elements":[]},{"id":"c7078d","elType":"widget","widgetType":"heading","settings":{"title":"メディア、研究者、政策立案者などにアピールする","header_size":"h2","align":"center","_title":"Heading","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]}]},{"id":"c7456b","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>研究機関やシンクタンクは、特にサステナビリティ、社会的公正、ビジネス、経済などの分野において、私たちの未来を形作る上で重要な役割を果たしています。MacroLingoはこれらすべての分野において豊富な経験を持っています。</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-1","_title":"The case"},"elements":[]},{"id":"c7645a","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>このような組織による画期的な研究は、日本だけでなく世界中で、社会変革のきっかけとなり、政策に影響を与え、イノベーションの推進に役立っています。しかし、このような複雑なアイデアは正しくグローバルオーディエンスに伝わっているのでしょうか？あなたの研究は正しい人々の目に届いているでしょうか？英語圏のオーディエンスにとって魅力的な文書やビジュアル資料を作成するための熟練したコピーライターやSEOの専門家はいますか？</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-2","_title":"The case"},"elements":[]},{"id":"c78349","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>研究には、明確性と説得力、そして科学的に正確なメッセージが求められます。高度で複雑な概念であっても、それを親しみやすい物語として伝え、研究のインパクトを示す必要があります。このような知識を、英語でも、海外からでもアクセスしやすく説得力のあるものにすることで、行動を喚起し、資金提供者を満足させることができるのです。</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-3","_title":"The case"},"elements":[]},{"id":"c7a238","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>適応やマイクロファイナンスなど、あまり「ホット」ではなく話題になることが少ない分野の場合は、さらにハードルが上がります。MacroLingoの存在意義はより良い未来の創造をサポートすることであり、このような話題になりにくい分野の方が実は重要性が高いことを知っています。MacroLingoは貴団体がより多くの言葉をオーディエンスに届けられるよう、共に力を合わせたいと思っています。</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-3","_title":"The case"},"elements":[]},{"id":"c7c127","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>MacroLingoは、戦略とアウトプットの質の両側面から、強力なコミュニケーション作りをサポートします。また、Googleでは知名度が評価されるため、オンライン検索における競争力の強化もお手伝いします。学術界や政府機関だけに留まることなく、公共領域もに進出し、貴団体の研究を重要な意思決定の場へ届けます。</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-3","_title":"The case"},"elements":[]}]},{"id":"c899b0","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","_element_id":"case-study","css_classes":"ml-inner ml-jp","_title":"Case study"},"elements":[{"id":"c87ac1","elType":"container","settings":{"width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-cs ml-cs-solo ml-reveal","_title":"Case study"},"elements":[{"id":"c85bd2","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"width":{"unit":"%","size":100},"css_classes":"ml-cs-words","_title":"The words"},"elements":[{"id":"c7ff05","elType":"widget","widgetType":"heading","settings":{"title":"事例","header_size":"h6","_css_classes":"ml-label","_title":"Label"},"elements":[]},{"id":"c81df4","elType":"widget","widgetType":"heading","settings":{"title":"Climate Change Performance Index","header_size":"h3","_css_classes":"ml-cs-head","_title":"Client","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"c83ce3","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Climate Change Performance Index（CCPI；ドイツ）は、毎年主要国政府が気候変動対策においてどれだけ責務を果たしているかを詳細に評価したランキングで、非常に強い影響力を持っています。報告書では、各国の専門家が様々な指標を用いて主要諸国のパフォーマンスを数値化し評価しています。MacroLingoは毎年この報告書の全域を校正し、言語の正確性、整合性、ローカライズのチェックを担当しています。またMacroLingoは、このような誠実で価値の高い情報を必要としているメディア、政府関係者、学生などに委託団体が情報を届けるためのSEOガイダンスも提供しています。</p>","_css_classes":"ml-cs-val","_title":"What we did"},"elements":[]}]}]}]},{"id":"cb6129","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","_element_id":"services","css_classes":"ml-inner ml-jp ml-band-blue","_title":"Services"},"elements":[{"id":"cac67e","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-section-head ml-reveal","_title":"Section heading"},"elements":[{"id":"ca88a0","elType":"widget","widgetType":"heading","settings":{"title":"サービス内容","header_size":"h6","align":"center","_css_classes":"ml-label ml-label-centred","_title":"Label"},"elements":[]},{"id":"caa78f","elType":"widget","widgetType":"heading","settings":{"title":"オーディエンス、読者、資金提供者、注目を集める","header_size":"h2","align":"center","_title":"Heading","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]}]},{"id":"cae56d","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>非政府組織（NGO）や非営利組織（NPO）向けに、次のようなサービスを提供しています。</p>","_css_classes":"ml-lead ml-reveal ml-reveal-1","_title":"Intro"},"elements":[]},{"id":"cb045c","elType":"container","settings":{"flex_direction":"row","flex_gap":{"unit":"px","size":"22","column":"22","row":"22","isLinked":true},"flex_wrap":"wrap","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"flex_align_items":"stretch","css_classes":"ml-svc-grid ml-reveal ml-reveal-2","_title":"The services"},"elements":[{"id":"c8f67d","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"研究のための英文ライティングと翻訳"},"elements":[{"id":"c8b89f","elType":"widget","widgetType":"heading","settings":{"title":"研究のための英文ライティングと翻訳","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"c8d78e","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>MacroLingoは、気候変動や地域紛争などの複雑なトピックの本質を捉えた、ニュアンスを伝える英文ライティングを日本のクライアントにお届けしています。新しいサステナビリティ技術の報告書の要約や、海外のステークホルダーや投資家に訴求するためのリライトも承ります。当社のサービスはクライアントの研究リーチを広げるだけでなく、世界的な注目と支持を集め、イノベーションとアクションの推進に貢献します。また、日本語が原文の資料にも対応しています。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"c9534a","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"研究機関のためのSEOとウェブプランニング"},"elements":[{"id":"c9156c","elType":"widget","widgetType":"heading","settings":{"title":"研究機関のためのSEOとウェブプランニング","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"c9345b","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>日本の研究機関の多くが、SEO対策に費やす時間や人材の不足に悩まされています。しかし、適正なSEO対策とウェブプラニングなしには、優れた研究であってもオンラインで発見することは困難です。MacroLingoのサービスを通じて、貴団体の研究成果をより発見しやすく、アクセスしやすく改善しましょう。例えば、研究内容が社会的公正を優先した新しい経済成長モデルの開発である場合、政策関係者、学界、一般層での認知度を高めるサポートを提供します。オンラインプレゼンスを強化することで、研究をプロモーションするだけでなく、海外や英語圏でもオピニオン・リーダーとしての位置を確立することにつながります。研究を広く知ってもらうためには、英語での発信が不可欠です。自動翻訳や直訳ではなく、科学的見解に基づいたネイティブによる「本物」の英語でなければなりません。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"c9b017","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"出版のための科学・学術英文校正"},"elements":[{"id":"c97239","elType":"widget","widgetType":"heading","settings":{"title":"出版のための科学・学術英文校正","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"c99128","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>MacroLingoでは、BELS認定エディターが科学的な内容を精査し、明確性、正確性、および特定のガイドラインや基準への準拠を保証します。当社のサービスでは、科学的厳密性を失うことなく、複雑な分析結果を読みやすい英文に変換することができます。これにより、その研究が専門家だけでなく、専門外の科学者や研究者を含むより広い読者層にとっても分かりやすいものとなります。結果として研究機関が世界規模で影響力を拡大し、重要課題に対するより広範な議論と理解を促進することにつながります</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"ca69b1","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"〒541-0053大阪府大阪市中央区本町4-2-12 野村不動産堺筋本町ビル8階"},"elements":[{"id":"c9cf06","elType":"widget","widgetType":"heading","settings":{"title":"〒541-0053大阪府大阪市中央区本町4-2-12 野村不動産堺筋本町ビル8階","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"c9edf5","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>co ***** @ ******** go.com</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"ca0ce4","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>名前 * メール * メッセージ・詳細 0 / 2000 参考資料、書類、ファイルなど Drag and Drop (or) Choose Files</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"ca2bd3","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Consent * プライバシーポリシー と 利用規約 に同意します。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"ca4ac2","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>送信</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]}]},{"id":"cb423a","elType":"container","settings":{"width":{"unit":"%","size":100},"css_classes":"ml-cta-centred ml-reveal ml-reveal-3","_title":"Call to action"},"elements":[{"id":"cb234b","elType":"widget","widgetType":"button","settings":{"text":"お問い合わせ","link":{"url":"/ja/contact-us/","is_external":"","nofollow":"","custom_attributes":"","label":""},"typography_typography":"custom","typography_font_size":{"unit":"px","size":14.5,"sizes":[]},"typography_font_weight":"600","typography_line_height":{"unit":"em","size":1.72