it":"px","top":"10","right":"0","bottom":"0","left":"0","isLinked":false},"_title":"Call to action"},"elements":[{"id":"a09aab","elType":"widget","widgetType":"button","settings":{"text":"Talk to us","link":{"url":"/contact-us/","is_external":"","nofollow":"","custom_attributes":"","label":""},"typography_typography":"custom","typography_font_size":{"unit":"px","size":14.5,"sizes":[]},"typography_font_weight":"600","typography_line_height":{"unit":"em","size":1.72,"sizes":[]},"border_radius":{"unit":"px","top":"None","right":"None","bottom":"None","left":"None","isLinked":false},"text_padding":{"unit":"px","top":"11","right":"21","bottom":"11","left":"21","isLinked":false},"_css_classes":"ml-btn-primary","_title":"Main button","__globals__":{"background_color":"globals/colors?id=primary"}},"elements":[]}]}]}]},{"id":"a1d001","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","_element_id":"why","css_classes":"ml-inner  ml-band-warm","_title":"Why this industry"},"elements":[{"id":"a15445","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-section-head ml-reveal","_title":"Section heading"},"elements":[{"id":"a11667","elType":"widget","widgetType":"heading","settings":{"title":"Content and language services for inbound tourism coming to Japan","header_size":"h6","align":"center","_css_classes":"ml-label ml-label-centred","_title":"Label"},"elements":[]},{"id":"a13556","elType":"widget","widgetType":"heading","settings":{"title":"Attract Japan-bound tourists for your campaigns","header_size":"h2","align":"center","_title":"Heading","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]}]},{"id":"a17334","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Japan&rsquo;s tourism sector, a mosaic of ancient traditions, stunning landscapes, and bustling urban centers, offers an incredible array of experiences for the global traveler. The country is a major destination post-pandemic, just as it was becoming pre-COVID. Tourists have many choices, they&rsquo;re no longer sticking to the &ldquo;Golden Road&rdquo; of Tokyo-to-Kyoto, and they need good guidance. MacroLingo will provide it for your company or agency.</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-1","_title":"The case"},"elements":[]},{"id":"a19223","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Based in Osaka and with over 20 years of experience living and traveling across Japan, we bring an unparalleled depth of cultural understanding and expertise in high-quality English content creation. From the serene beauty of Kyoto&rsquo;s temples and the vibrant energy of Tokyo&rsquo;s streets to the breathtaking views of Mt. Fuji and the historical richness of Hiroshima, we specialize in transforming these diverse Japanese attractions into compelling narratives for international audiences.</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-2","_title":"The case"},"elements":[]},{"id":"a1b112","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>We know what appeals to different demographics &ndash; such as North American and European tourists&rsquo; fascination with Japan&rsquo;s modern cities, natural beauty, manga, and pop culture, and Asian tourists&rsquo; interest in shopping and Instagrammable spots. We use this to tailor content that resonates globally.</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-3","_title":"The case"},"elements":[]}]},{"id":"a2a88a","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","_element_id":"case-study","css_classes":"ml-inner","_title":"Case study"},"elements":[{"id":"a2899b","elType":"container","settings":{"width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-cs ml-cs-solo ml-reveal","_title":"Case study"},"elements":[{"id":"a26aac","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"width":{"unit":"%","size":100},"css_classes":"ml-cs-words","_title":"The words"},"elements":[{"id":"a1eef0","elType":"widget","widgetType":"heading","settings":{"title":"CASE STUDY","header_size":"h6","_css_classes":"ml-label","_title":"Label"},"elements":[]},{"id":"a20ddf","elType":"widget","widgetType":"heading","settings":{"title":"AA Media Agency* (Tokyo)","header_size":"h3","_css_classes":"ml-cs-head","_title":"Client","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"a22cce","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>MacroLingo helped this Japan-based but global agency create a successful part of an extensive tourism campaign about the greater Tokyo region. This required translation and copywriting as the basic skills. But, as the translation was tied with knowledge of Japan, words, nuances, and names and places, MacroLingo was uniquely qualified to deliver.</p>","_css_classes":"ml-cs-val","_title":"What we did"},"elements":[]},{"id":"a24bbd","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>*Name withheld to protect client privacy.</p>","_css_classes":"ml-cs-val","_title":"What we did"},"elements":[]}]}]}]},{"id":"a57003","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","_element_id":"services","css_classes":"ml-inner  ml-band-blue","_title":"Services"},"elements":[{"id":"a4d558","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-section-head ml-reveal","_title":"Section heading"},"elements":[{"id":"a4977a","elType":"widget","widgetType":"heading","settings":{"title":"What we do","header_size":"h6","align":"center","_css_classes":"ml-label ml-label-centred","_title":"Label"},"elements":[]},{"id":"a4b669","elType":"widget","widgetType":"heading","settings":{"title":"Offer the best of Japan to inbound tourists","header_size":"h2","align":"center","_title":"Heading","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]}]},{"id":"a4f447","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>For tourism-related clients, some of our services are&hellip;</p>","_css_classes":"ml-lead ml-reveal ml-reveal-1","_title":"Intro"},"elements":[]},{"id":"a51336","elType":"container","settings":{"flex_direction":"row","flex_gap":{"unit":"px","size":"22","column":"22","row":"22","isLinked":true},"flex_wrap":"wrap","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"flex_align_items":"stretch","css_classes":"ml-svc-grid ml-reveal ml-reveal-2","_title":"The services"},"elements":[{"id":"a34335","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"Localization of destination content"},"elements":[{"id":"a2c779","elType":"widget","widgetType":"heading","settings":{"title":"Localization of destination content","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"a2e668","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Experience bespoke localization services no matter if the destination is major, like Kyoto, or lesser-known, like Okayama or Tottori. We work from the reader&rsquo;s perspective. Are they foodies? Anime otaku? Seeking property or investment?</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"a30557","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Too many Japan tourism campaigns are not thinking from this perspective and fall back on generalizations and cliches. You don&rsquo;t have to settle for that anymore.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"a32446","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p><a href=\"/localization-translation/\">Check our localization &amp; translation solutions</a></p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"a3dde0","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"SEO for tourism content"},"elements":[{"id":"a36224","elType":"widget","widgetType":"heading","settings":{"title":"SEO for tourism content","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"a38113","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Make a strong online presence with SEO strategies in your tourism content. Many campaigns and promotions are not designed in a structure that helps them rank well on search engines. But when promoting Japan, you&rsquo;re promoting a hugely popular destination. Your words (and images and web structure) must be competitive.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"a3a002","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Attractions such as the snow-capped mountains of Hokkaido and the culinary adventures in Osaka are hot spots with thousands upon thousands of articles and videos about them, while smaller destinations like Kochi or Niigata need to be effectively described and marketed. Optimize your content strategically, and you can enjoy more website traffic, more prospects, and more bookings.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"a3bef1","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p><a href=\"/ai-search-optimization/\">Check our SEO and AI search solutions</a></p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"a4788b","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"Web content for travel"},"elements":[{"id":"a3fccf","elType":"widget","widgetType":"heading","settings":{"title":"Web content for travel","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"a41bbe","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Transform your website into an inviting portal for inbound international tourists seeking the best spots in Japan. We&rsquo;ll create content that not only informs but also immerses visitors in the Japanese travel experience.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"a43aad","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>We can do in-depth guides on cultural landmarks and local cuisine, and comprehensive information on unique activities like tea ceremony and matcha in Kyoto or cherry blossom viewing in Tohoku. Our content encourages exploration and booking, and your website serves as a complete guide, captivating potential tourists with detailed descriptions and useful information.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"a4599c","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p><a href=\"/industry-content-seo/\">See our lineup of content solutions</a></p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]}]},{"id":"a55114","elType":"container","settings":{"width":{"unit":"%","size":100},"css_classes":"ml-cta-centred ml-reveal ml-reveal-3","_title":"Call to action"},"elements":[{"id":"a53225","elType":"widget","widgetType":"button","settings":{"text":"Talk to us about your project","link":{"url":"/contact-us/","is_external":"","nofollow":"","custom_attributes":"","label":""},"typography_typography":"custom","typography_font_size":{"unit":"px","size":14.5,"sizes":[]},"typography_font_weight":"600","typography_line_height":{"unit":"em","size":1.72,"sizes":[]},"border_radius":{"unit":"px","top":"None","right":"None","bottom":"None","left":"None","isLinked":false},"text_padding":{"unit":"px","top":"11","right":"21","bottom":"11","left":"21","isLinked":false},"_css_classes":"ml-btn-primary","_title":"Button","__globals__":{"background_color":"globals/colors?id=primary"}},"elements":[]}]}]},{"id":"a5ccd0","elType":"contai