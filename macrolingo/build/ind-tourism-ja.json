":14.5,"sizes":[]},"typography_font_weight":"600","typography_line_height":{"unit":"em","size":1.72,"sizes":[]},"border_radius":{"unit":"px","top":"8","right":"8","bottom":"8","left":"8","isLinked":false},"text_padding":{"unit":"px","top":"11","right":"21","bottom":"11","left":"21","isLinked":false},"_css_classes":"ml-btn-primary","_title":"Main button","__globals__":{"background_color":"globals/colors?id=primary"}},"elements":[]}]}]}]},{"id":"d0b23d","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","_element_id":"why","css_classes":"ml-inner ml-jp ml-band-warm","_title":"Why this industry"},"elements":[{"id":"d03681","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-section-head ml-reveal","_title":"Section heading"},"elements":[{"id":"cff8a3","elType":"widget","widgetType":"heading","settings":{"title":"訪日観光客向けのコンテンツ・多言語サービス","header_size":"h6","align":"center","_css_classes":"ml-label ml-label-centred","_title":"Label"},"elements":[]},{"id":"d01792","elType":"widget","widgetType":"heading","settings":{"title":"キャンペーンを訪日観光客向けにアピールしよう","header_size":"h2","align":"center","_title":"Heading","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]}]},{"id":"d05570","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>日本観光には、古き良き伝統、美しい風景、賑やかな都心部など様々な魅力があり、世界の旅行者に素晴らしい体験を提供しています。コロナ以前と同様、パンデミックの後も日本は主要な旅行先としての人気を誇り続けています。日本が観光客を惹きつける理由にはソフトパワーの強さ、美しさ、素晴らしい食文化などがあり、現在は円安も人気を後押しする要因のひとつとなっています。このような数々のチャンスを利用しない理由はありません。選択肢が豊富な観光地だからこそ、日本を訪れる観光客は適切なガイドを求めています。MacroLingoは、観光客が求めているコンテンツを御社に提供します。</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-1","_title":"The case"},"elements":[]},{"id":"d0745f","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>福岡を拠点とし、20年以上にわたって日本各地に旅行・居住してきた私たちだからこそできる、日本文化への深い造詣を生かした質の高い英語コンテンツ制作の専門知識をお届けします。京都の寺院の静謐な美しさ、東京の活気あふれる街並み、息を呑むような富士山の絶景、広島の豊かな歴史など、私たちは日本の多様な魅力を、世界のオーディエンスに訴求する方法で発信することを得意としています。</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-2","_title":"The case"},"elements":[]},{"id":"d0934e","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>MacroLingoは、異なる地域の観光客にとって日本の何が魅力的なのかを熟知しています。例えば、北米やヨーロッパからの観光客は日本の近代的な都市、美しい自然、漫画、ポップカルチャーに魅了される傾向がありますが、アジアの観光客はショッピングやインスタ映えするスポットに興味を持っています。このような知識をもとに、グローバルなターゲット層を惹きつけるコンテンツをカスタマイズしています。</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-3","_title":"The case"},"elements":[]}]},{"id":"d16bd7","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","_element_id":"case-study","css_classes":"ml-inner ml-jp","_title":"Case study"},"elements":[{"id":"d14ce8","elType":"container","settings":{"width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-cs ml-cs-solo ml-reveal","_title":"Case study"},"elements":[{"id":"d12df9","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"width":{"unit":"%","size":100},"css_classes":"ml-cs-words","_title":"The words"},"elements":[{"id":"d0d12c","elType":"widget","widgetType":"heading","settings":{"title":"事例","header_size":"h6","_css_classes":"ml-label","_title":"Label"},"elements":[]},{"id":"d0f01b","elType":"widget","widgetType":"heading","settings":{"title":"○○ 広告代理店※（東京）","header_size":"h3","_css_classes":"ml-cs-head","_title":"Client","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"d10f0a","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>このクライアントは、日本を拠点としながらグローバルに活動するエージェンシーです。MacroLingoは、東京圏での大規模な観光キャンペーンを成功させるためのサポートを行いました。このプロジェクトには、基本的なスキルとして翻訳とコピーライティングが必要でした。翻訳には日本特有の言葉、ニュアンス、人名・地名など日本に対する深い知識が必要であったため、MacroLingoが唯一無二の能力を発揮しました。</p>","_css_classes":"ml-cs-val","_title":"What we did"},"elements":[]}]}]}]},{"id":"d43350","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","_element_id":"services","css_classes":"ml-inner ml-jp ml-band-blue","_title":"Services"},"elements":[{"id":"d398a5","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-section-head ml-reveal","_title":"Section heading"},"elements":[{"id":"d35ac7","elType":"widget","widgetType":"heading","settings":{"title":"サービス内容","header_size":"h6","align":"center","_css_classes":"ml-label ml-label-centred","_title":"Label"},"elements":[]},{"id":"d379b6","elType":"widget","widgetType":"heading","settings":{"title":"インバウンド観光客に日本の魅力を伝える","header_size":"h2","align":"center","_title":"Heading","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]}]},{"id":"d3b794","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>観光業界向けに、以下のサービスを提供しています。</p>","_css_classes":"ml-lead ml-reveal ml-reveal-1","_title":"Intro"},"elements":[]},{"id":"d3d683","elType":"container","settings":{"flex_direction":"row","flex_gap":{"unit":"px","size":"22","column":"22","row":"22","isLinked":true},"flex_wrap":"wrap","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"flex_align_items":"stretch","css_classes":"ml-svc-grid ml-reveal ml-reveal-2","_title":"The services"},"elements":[{"id":"d1c8a4","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"観光地に合わせたコンテンツの英訳・ローカライズ"},"elements":[{"id":"d18ac6","elType":"widget","widgetType":"heading","settings":{"title":"観光地に合わせたコンテンツの英訳・ローカライズ","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"d1a9b5","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>MacroLingoは京都や東京のような人気観光地だけでなく、まだあまり知られていない岡山や鳥取のような観光地であっても、文章の絶妙なニュアンスまで表現したカスタマイズローカライズサービスを提供します。私たちは、常にオーディエンスの視点に立ってローカライズを行うことを大切にしています。ターゲットとなる訪日観光客はグルメを求めているのか？アニメファンなのか？不動産や投資が目的なのか？多くの日本観光キャンペーンはこのような視点に立つことを忘れ、ありふれた表現や決まり文句に頼った不自然な英文になってしまいがちです。MacroLingoのサービスなら、もうこのような問題に悩まされる心配はありません。日本語も堪能な外国人プロフェッショナルだからこそ、外国人観光客が何を求めているかを熟知した上でローカライズを行います</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"d22571","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"観光コンテンツのSEO"},"elements":[{"id":"d1e793","elType":"widget","widgetType":"heading","settings":{"title":"観光コンテンツのSEO","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"d20682","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>日本観光のコンテンツにSEO対策を実施し、オンラインプレセンスを強化しましょう。多くのキャンペーンやプロモーションは、残念ながら検索エンジンで上位表示されるようにデザインされていません。日本をプロモーションする場合、日本が観光地として非常に人気の高い場所であることを考慮しなければなりません。つまり、テキストや画像、ウェブ構造にも強い競争力が求められるということです。例えば、雪に覆われた北海道の山々や大阪のグルメ旅行などのアトラクションは、何千、何万もの記事や動画が存在するホットスポットです。反対に、高知や新潟のような比較的小規模の観光地の場合は、効果的な表現方法でマーケティングを行う必要があります。このように戦略的にコンテンツを最適化することで、ウェブサイトのトラフィックや潜在顧客、予約の数を増加させることができます。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"d2823e","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"観光業界のためのウェブコンテンツ"},"elements":[{"id":"d24460","elType":"widget","widgetType":"heading","settings":{"title":"観光業界のためのウェブコンテンツ","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"d2634f","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>御社のウェブサイトを、日本のベストスポットを求めるインバウンド観光客にとって魅力的なウェブサイトに変身させましょう。MacroLingoは単に情報を提供するだけでなく、日本の旅行体験に浸ってもらえるようなコンテンツを作成します。文化的名所やご当地グルメに関する詳細なガイドはもちろん、京都での茶道や抹茶体験、東北でのお花見などのユニークなアクティビティに関する総合的な情報まで、幅広いコンテンツを作成します。MacroLingoの提供するコンテンツは、ユーザーに更なるページの閲覧や予約といったアクションを促します。詳しい説明と有益な情報で潜在顧客を魅了し、包括的なガイドとして役立つウェブサイトを提供します。</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"d33bd8","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"〒541-0053大阪府大阪市中央区本町4-2-12 野村不動産堺筋本町ビル8階"},"elements":[{"id":"d2a12d","elType":"widget","widgetType":"heading","settings":{"title":"〒541-0053大阪府大阪市中央区本