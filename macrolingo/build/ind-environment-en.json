ls/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]}]},{"id":"a17334","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>You make our world greener and more sustainable. The environmental services sector is critical in addressing our planet&rsquo;s ecological challenges. With increasing focus on sustainability and environmental preservation, effective communication is essential to inform the world about your products, services, and research. From agencies to companies, to innovative eco-services and technology, you need effective storytelling and messaging to get the public&rsquo;s attention.</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-1","_title":"The case"},"elements":[]},{"id":"a19223","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Accessible and compelling information creates action. Your company or organization must lead in environmental advocacy, innovation, sustainable living, and a greener future.</p>","_css_classes":"ml-lead-body ml-reveal ml-reveal-2","_title":"The case"},"elements":[]}]},{"id":"a26aac","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","_element_id":"case-study","css_classes":"ml-inner","_title":"Case study"},"elements":[{"id":"a24bbd","elType":"container","settings":{"width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-cs ml-cs-solo ml-reveal","_title":"Case study"},"elements":[{"id":"a22cce","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"width":{"unit":"%","size":100},"css_classes":"ml-cs-words","_title":"The words"},"elements":[{"id":"a1d001","elType":"widget","widgetType":"heading","settings":{"title":"CASE STUDY","header_size":"h6","_css_classes":"ml-label","_title":"Label"},"elements":[]},{"id":"a1eef0","elType":"widget","widgetType":"heading","settings":{"title":"Rijk Zwaan","header_size":"h3","_css_classes":"ml-cs-head","_title":"Client","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"a20ddf","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>This Dutch agriculture company needed to effectively communicate its effective seed and produce development in Japan. As MacroLingo (formerly Scize) is based in Japan, we were uniquely equipped to provide reporting in English and Japanese that accurately covers both the technology and cultural aspects in this work.</p>","_css_classes":"ml-cs-val","_title":"What we did"},"elements":[]}]}]}]},{"id":"a5ebbf","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","_element_id":"services","css_classes":"ml-inner  ml-band-blue","_title":"Services"},"elements":[{"id":"a57003","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-section-head ml-reveal","_title":"Section heading"},"elements":[{"id":"a53225","elType":"widget","widgetType":"heading","settings":{"title":"What we do","header_size":"h6","align":"center","_css_classes":"ml-label ml-label-centred","_title":"Label"},"elements":[]},{"id":"a55114","elType":"widget","widgetType":"heading","settings":{"title":"Relevant services","header_size":"h2","align":"center","_title":"Heading","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]}]},{"id":"a58ef2","elType":"container","settings":{"flex_direction":"row","flex_gap":{"unit":"px","size":"22","column":"22","row":"22","isLinked":true},"flex_wrap":"wrap","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"flex_align_items":"stretch","css_classes":"ml-svc-grid ml-reveal ml-reveal-1","_title":"The services"},"elements":[{"id":"a30557","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"Expert-written blogs and content"},"elements":[{"id":"a2899b","elType":"widget","widgetType":"heading","settings":{"title":"Expert-written blogs and content","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"a2a88a","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>We work with scientists and talented writers to create high-quality, informative blogs and content. This is marketing you can be proud of and that gets results.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"a2c779","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Expert articles, blog posts, and valuable insights into environmental issues, green technologies, and sustainability trends.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"a2e668","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>This strategic content creation boosts your digital marketing, driving traffic to your site and increasing engagement with potential customers.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"a3a002","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"Web reform and SEO"},"elements":[{"id":"a32446","elType":"widget","widgetType":"heading","settings":{"title":"Web reform and SEO","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"a34335","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Optimize your website for the eco-friendly market with our specialized web reform and SEO.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"a36224","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>We'll help you rethink your web presentation and structure, ask you hard questions to help you realize and show your true value, and then put it in words and online.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"a38113","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>We can also do in-depth keyword research to ensure your site ranks high on the terms you're targeting.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"a41bbe","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"Copywriting for tech, products, services"},"elements":[{"id":"a3bef1","elType":"widget","widgetType":"heading","settings":{"title":"Copywriting for tech, products, services","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"a3dde0","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Benefit from engaging, persuasive content for green technology, products, and research. We highlight your products' environmental benefits, innovative features, and usability.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"a3fccf","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Our copy is designed to appeal to your target audience, whether for web content, product brochures, or advertising campaigns.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"a4977a","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"Case studies, reports"},"elements":[{"id":"a43aad","elType":"widget","widgetType":"heading","settings":{"title":"Case studies, reports","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"a4599c","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Showcase the effectiveness and impact of your products and your work with our case study and report writing services. We create detailed documents that highlight your successes in real-world scenarios.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"a4788b","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>This way, you can give evidence of your great work, not just say that it's great. This builds trust with clients, partners, and stakeholders, and positions your company as a trusted leader in environmental solutions.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]},{"id":"a51336","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-svc","_title":"Branding and naming"},"elements":[{"id":"a4b669","elType":"widget","widgetType":"heading","settings":{"title":"Branding and naming","header_size":"h3","_css_classes":"ml-svc-title","_title":"Service","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"a4d558","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>Develop a strong brand identity for your eco-products with our branding and marketing writing. We create compelling stories and messages that highlight your products' unique benefits and environmental impact.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]},{"id":"a4f447","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>We research the competition and give ideas on how you can compete. If you need a name for your product lineup, no matter what the source language is, we can help.</p>","_css_classes":"ml-svc-note","_title":"What it is"},"elements":[]}]}]},{"id":"a5ccd0","elType":"container","settings":{"width":{"unit":"%","size":100},"css_classes":"ml-cta-centred ml-reveal ml-reveal-2","_title":"Call to action"},"elements":[{"id":"a5ade1","elType":"widget","widgetType":"button","settings":{"text":"Talk to us about your project","link":{"url":"/contact-us/","is_external":"","nofollow":"","custom_attributes":"","label":""},"typography_typography":"custom","typography_font_size":{"unit":"px","size":14.5,"sizes":[]},"typography_font_weight":"600","typography_line_height":{"unit":"em","size":1.72,"sizes":[]},"border_radius":{"unit":"px","top":"None","right":"None","bottom":"None","left":"None","isLinked":false},"text_padding":{"unit":"px","top":"11","right":"21","bottom":"11","left":"21","isLinked":false},"_css_classes":"ml-btn-primary","_title":"Button","__globals__":{"background_color":"globals