lType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-card ml-service-card ml-reveal ml-reveal-1","_title":"グローバルなオーディエンスに対応"},"elements":[{"id":"a19223","elType":"widget","widgetType":"icon-box","settings":{"selected_icon":{"value":"fas fa-globe","library":"fa-solid"},"title_text":"グローバルなオーディエンスに対応","description_text":"英語は世界中のコミュニケーションの共通言語であり、様々なレベルでの明確なコミュニケーションが求められます。私たちは、理解しやすく、かつ共感を呼ぶコンテンツ制作に力を入れています。","position":"left","position_mobile":"left","title_size":"h3","icon_space":{"unit":"px","size":20,"sizes":[]},"text_align":"left","text_align_mobile":"left","_css_classes":"ml-i-globe ml-service ml-value","_title":"Value"},"elements":[]}]},{"id":"a1eef0","elType":"container","settings":{"width":{"unit":"%","size":100},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"css_classes":"ml-card ml-service-card ml-reveal ml-reveal-2","_title":"エコフレンドリー"},"elements":[{"id":"a1d001","elType":"widget","widgetType":"icon-box","settings":{"selected_icon":{"value":"fas fa-leaf","library":"fa-solid"},"title_text":"エコフレンドリー","description_text":"地球には限られた時間しか存在できません。だからこそ、MacroLingoはサステナブルな社会の実現に向けて、地球に優しいクライアントとのみお仕事をさせていただいています。","position":"left","position_mobile":"left","title_size":"h3","icon_space":{"unit":"px","size":20,"sizes":[]},"text_align":"left","text_align_mobile":"left","_css_classes":"ml-i-leaf ml-service ml-value","_title":"Value"},"elements":[]}]}]}]},{"id":"a32446","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"center","_element_id":"approach","css_classes":"ml-inner ml-jp ml-band-warm","_title":"Made in Japan"},"elements":[{"id":"a2e668","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"flex_align_items":"stretch","width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-section-head ml-reveal","_title":"Section heading"},"elements":[{"id":"a2a88a","elType":"widget","widgetType":"heading","settings":{"title":"日本と西洋のベストを融合した","header_size":"h6","align":"center","_css_classes":"ml-label ml-label-centred","_title":"Label"},"elements":[]},{"id":"a2c779","elType":"widget","widgetType":"heading","settings":{"title":"日本の仕事の美学に国際的な視点を加えた<span class=\"ml-highlight\">アプローチ</span>","header_size":"h2","align":"center","_title":"Heading","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]}]},{"id":"a30557","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>MacroLingo（旧Scize Group）は、福岡で設立され、大阪に拠点を移しました。アメリカンな顔を持ちながらも、20年にわたる日本の企業および学術界で培った豊富な経験があります。私たちは日本の仕事観を尊重し、お客様は神様であり、細部にまで注意深く耳を傾け、全体を把握します。年功序列や専門性を重んじ、試行錯誤を繰り返しながら、品質を徹底的に追求します。たとえ基本的な業務であっても、自分たちの仕事に誇りを持ち、常に改善を図ります。これらの仕事観は、どの国のクライアントにも通づる基本です。それと同時に、アメリカンな情熱、競争心、迅速な実行力に加え、少しのオーストラリアンな親しみやすさと楽しさを大切にしています。日本と西洋の良さを融合させ、世界中の皆さまに最高のサービスをお届けします。</p>","_css_classes":"ml-prose ml-prose-wide ml-reveal ml-reveal-1","_title":"The passage"},"elements":[]}]},{"id":"a53225","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"_element_id":"founder","css_classes":"ml-inner ml-jp","_title":"Owner"},"elements":[{"id":"a4599c","elType":"container","settings":{"width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-split-founder ml-reveal","_title":"Picture and words"},"elements":[{"id":"a38113","elType":"container","settings":{"flex_gap":{"unit":"px","size":"18","column":"18","row":"18","isLinked":true},"css_classes":"ml-adam-photo","_title":"Adam photo"},"elements":[{"id":"a34335","elType":"widget","widgetType":"image","settings":{"image":{"id":2268,"url":"https://staging1.macrolingo.com/wp-content/uploads/2024/07/Adam-Scize.jpg","alt":"Dr. Adam Goulston（アダム・グールストン）博士、大阪","source":"library","size":""},"image_size":"full","_css_classes":"ml-photo ml-photo-square","_title":"Adam"},"elements":[]},{"id":"a36224","elType":"widget","widgetType":"image","settings":{"image":{"id":2270,"url":"https://staging1.macrolingo.com/wp-content/uploads/2024/07/BELS.png","alt":"Board-certified Editor in the Life Sciences","source":"library","size":""},"image_size":"full","_css_classes":"ml-bels","_title":"BELS badge"},"elements":[]}]},{"id":"a43aad","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"_title":"Adam words"},"elements":[{"id":"a3a002","elType":"widget","widgetType":"heading","settings":{"title":"オーナー","header_size":"h6","_css_classes":"ml-label","_title":"Label"},"elements":[]},{"id":"a3bef1","elType":"widget","widgetType":"heading","settings":{"title":"Dr. Adam Goulston（アダム・グールストン）博士","header_size":"h2","_css_classes":"ml-heading-founder","_title":"Heading","__globals__":{"title_color":"globals/colors?id=secondary","typography_typography":"globals/typography?id=primary"}},"elements":[]},{"id":"a3dde0","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>皆様の国際的なビジネスの挑戦に寄り添い、全力でサポートします。</p>","_css_classes":"ml-founder-line","_title":"His line"},"elements":[]},{"id":"a3fccf","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>私がこの会社を立ち上げた理由は、一般的なエージェンシーでは扱いきれない難しいトピックや、グローバルなオーディエンスに応える必要性を感じたからです。私たちは、そのようなニーズに最適に応えるパートナーです。アメリカで生まれ育ち、成人後は主にアジアでの生活を通じて、外国語の習得やジャーナリズム、リサーチにおける独自のマインドセットを身につけてきました。私自身の能力と、グローバルな経験を持つ仲間たちと共に、皆さまに最高のサービスを提供いたします。</p><p>アメリカ合衆国出身の日本永住者で、心理学博士（PsyD）および経営学修士号（MBA）を含む3つの修士号を保有しています。25年あまりにわたる校正・ライティングの経験を持ち、その内およそ18年間は日本の公的機関・企業・個人のお客様を対象にライター・校正者・マーケターとしてサービスの提供を行ってきました。また、シリコンバレーや東京のインターネットサービスプロバイダーで20年にわたって勤務した経験もあり。</p>","_css_classes":"ml-bio-wide","_title":"Profile","__globals__":{"text_color":"globals/colors?id=text"}},"elements":[]},{"id":"a41bbe","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>アダム</p>","_css_classes":"ml-signature","_title":"Signature"},"elements":[]}]}]},{"id":"a51336","elType":"widget","widgetType":"icon-list","settings":{"icon_list":[{"_id":"a4788b","text":"人間・組織心理学博士 (PsyD)","selected_icon":{"value":"fas fa-check","library":"fa-solid"},"link":{"url":"","is_external":"","nofollow":"","custom_attributes":"","label":""}},{"_id":"a4977a","text":"マーケティング経営学修士（MBA）・健康科学の理学修士（MS）（公衆衛生）","selected_icon":{"value":"fas fa-check","library":"fa-solid"},"link":{"url":"","is_external":"","nofollow":"","custom_attributes":"","label":""}},{"_id":"a4b669","text":"国際社会開発修士（MISD）・ジャーナリズム学士号（BA）","selected_icon":{"value":"fas fa-check","library":"fa-solid"},"link":{"url":"","is_external":"","nofollow":"","custom_attributes":"","label":""}},{"_id":"a4d558","text":"Board-certified Editor in the Life Sciences 校正者資格 (ELS)","selected_icon":{"value":"fas fa-check","library":"fa-solid"},"link":{"url":"","is_external":"","nofollow":"","custom_attributes":"","label":""}},{"_id":"a4f447","text":"Certified Professional Resume Writer 認定専門履歴書作成者 (CPRW)","selected_icon":{"value":"fas fa-check","library":"fa-solid"},"link":{"url":"","is_external":"","nofollow":"","custom_attributes":"","label":""}}],"view":"traditional","_css_classes":"ml-ticks ml-ticks-founder ml-cred-wide ml-i-tick ml-reveal ml-reveal-1","_title":"Qualifications"},"elements":[]}]},{"id":"a5ccd0","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bott