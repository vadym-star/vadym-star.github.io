e_tag":"h3","default_state":"all_collapsed","max_items_expended":"multiple","title_typography_typography":"custom","title_typography_font_size":{"unit":"px","size":18.5,"sizes":[]},"title_typography_line_height":{"unit":"em","size":1.72,"sizes":[]},"icon_size":{"unit":"px","size":24,"sizes":[]},"_css_classes":"ml-faq ml-reveal","_title":"Questions, left"},"elements":[{"id":"adc66e","elType":"container","settings":{"_title":"どの言語に対応していますか？"},"elements":[{"id":"ada77f","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>日本語から英語（専門分野）、韓国語・中国語・タイ語から英語に対応しています。キャッチコピーのような短い文章であれば、他言語への翻訳も承ります。その他の言語には対応しておりませんが、お気軽にご相談ください。</p>","_title":"Answer","__globals__":{"text_color":"globals/colors?id=text"}},"elements":[]}]},{"id":"ae233b","elType":"container","settings":{"_title":"料金はいくらですか？"},"elements":[{"id":"ae044c","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>作業の量や複雑さに応じて料金を決定します。大規模なプロジェクトや継続的な契約には割引もご用意しております。詳しくはお問い合わせください。</p>","_title":"Answer","__globals__":{"text_color":"globals/colors?id=text"}},"elements":[]}]},{"id":"ae8008","elType":"container","settings":{"_title":"本の翻訳をお願いできますか？"},"elements":[{"id":"ae6119","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>恐れ入りますが、書籍やマニュアルといった文章の翻訳は対応しておりません。私たちのサービスは、営業やマーケティングの成果を上げ、異文化間のコミュニケーションを円滑にするために、自然でネイティブな英語の翻訳を提供しています。</p>","_title":"Answer","__globals__":{"text_color":"globals/colors?id=text"}},"elements":[]}]}]},{"id":"af7780","elType":"widget","widgetType":"nested-accordion","settings":{"items":[{"_id":"aebde6","item_title":"どのような内容の翻訳を対応していますか？"},{"_id":"af1ab3","item_title":"「ローカライゼーション」とは何ですか？"}],"title_tag":"h3","default_state":"all_collapsed","max_items_expended":"multiple","title_typography_typography":"custom","title_typography_font_size":{"unit":"px","size":18.5,"sizes":[]},"title_typography_line_height":{"unit":"em","size":1.72,"sizes":[]},"icon_size":{"unit":"px","size":24,"sizes":[]},"_css_classes":"ml-faq ml-reveal ml-reveal-1","_title":"Questions, right"},"elements":[{"id":"aefbc4","elType":"container","settings":{"_title":"どのような内容の翻訳を対応していますか？"},"elements":[{"id":"aedcd5","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>ウェブサイト、ランディングページや製品ページ、プレスリリース、ブログ、寄付や社内コミュニケーションなど、セールスやマーケティングに関連するトピックの翻訳に対応します。法律文書、技術マニュアル、医療文書などの専門分野の翻訳には対応しておりません。</p>","_title":"Answer","__globals__":{"text_color":"globals/colors?id=text"}},"elements":[]}]},{"id":"af5891","elType":"container","settings":{"_title":"「ローカライゼーション」とは何ですか？"},"elements":[{"id":"af39a2","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p>ローカライゼーション（localization）は、単なる翻訳を超えた、より深いプロセスです。単語ごとの直訳ではなく、内容の意味や対象のオーディエンス、意図をしっかりと考慮して調整を行います。言語を最適化し、トーンや意図、特定の表現が読者に完全に合うように仕上げます。例えば、日本語のウェブサイトをグローバルなオーディエンス向けに翻訳する場合、日本語の内容を基にしつつ、ターゲットや目的に合わせて翻訳をリライトします。</p>","_title":"Answer","__globals__":{"text_color":"globals/colors?id=text"}},"elements":[]}]}]}]}]},{"id":"b2d9a4","elType":"container","settings":{"padding":{"unit":"px","top":"92","right":"30","bottom":"92","left":"30","isLinked":false},"padding_mobile":{"unit":"px","top":"56","right":"30","bottom":"56","left":"30","isLinked":false},"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"_element_id":"contact","css_classes":"ml-inner ml-jp ml-band-warm","_title":"Contact"},"elements":[{"id":"b2bab5","elType":"container","settings":{"width":{"unit":"%","size":100},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"css_classes":"ml-split-contact ml-reveal","_title":"Two columns"},"elements":[{"id":"b23ef9","elType":"container","settings":{"flex_gap":{"unit":"px","size":"0","column":"0","row":"0","isLinked":true},"_title":"Contact details"},"elements":[{"id":"afd44d","elType":"widget","widgetType":"heading","settings":{"title":"お問い合わせ","header_size":"h6","_css_classes":"ml-label","_title":"Label"},"elements":[]},{"id":"aff33c","elType":"widget","widgetType":"heading","settings":{"title":"翻訳・ローカライズのご相談を承ります","he